{
  "name": "eventx-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "EventX — gift/moi collection tracker, packaged as an Android app via Capacitor",
  "scripts": {
    "serve": "npx http-server www -p 5173 -c-1",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  }
}
